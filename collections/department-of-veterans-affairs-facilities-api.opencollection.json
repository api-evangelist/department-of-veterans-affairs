{
  "opencollection": "1.0.0",
  "info": {
    "name": "VA Appeals Status AllergyIntolerance Facilities API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Facilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List or search VA facilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/v1/facilities",
            "params": [
              {
                "name": "bbox[]",
                "value": "",
                "type": "query",
                "description": "Bounding box (lng_min, lat_min, lng_max, lat_max)"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated facility IDs"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "services[]",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "zip",
                "value": "",
                "type": "query"
              },
              {
                "name": "visn",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search VA facilities by bounding box, ids, type, services, zip, state, or visn."
        },
        {
          "info": {
            "name": "Retrieve a single VA facility",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/v1/facilities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single VA facility"
        }
      ]
    }
  ],
  "bundled": true
}