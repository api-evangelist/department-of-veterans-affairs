{
  "opencollection": "1.0.0",
  "info": {
    "name": "VA Appeals Status AllergyIntolerance Forms API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Forms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List VA forms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/v1/forms",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query against form name or title"
              }
            ]
          },
          "docs": "Returns the full or filtered list of VA forms."
        },
        {
          "info": {
            "name": "Retrieve a single VA form",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/v1/forms/:form_name",
            "params": [
              {
                "name": "form_name",
                "value": "10-10EZ",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single VA form"
        }
      ]
    }
  ],
  "bundled": true
}