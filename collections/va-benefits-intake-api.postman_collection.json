  "info": {
    "_postman_id": "a21e8556-c54d-4c88-a577-0463b0143bc9",
    "name": "VA Benefits Intake API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Benefits Intake API allows authorized partners to digitally submit PDF documents for VA benefit applications. The workflow uses an upload-location model: request a presigned upload URL, PUT the document and metadata, and poll the resulting GUID for processing status.\n\nContact Support:\n Name: VA API Platform",
      "type": "text/plain"
    }
  }
