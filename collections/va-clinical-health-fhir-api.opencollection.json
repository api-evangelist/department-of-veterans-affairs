{
  "opencollection": "1.0.0",
  "info": {
    "name": "VA Clinical Health API (FHIR)",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sandbox-api.va.gov/oauth2/health/v1/authorization",
      "accessTokenUrl": "https://sandbox-api.va.gov/oauth2/health/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Patient",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read a FHIR Patient resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/fhir/v0/r4/Patient/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read a FHIR Patient resource"
        }
      ]
    },
    {
      "info": {
        "name": "AllergyIntolerance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search AllergyIntolerance resources for a patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/fhir/v0/r4/AllergyIntolerance",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search AllergyIntolerance resources for a patient"
        }
      ]
    },
    {
      "info": {
        "name": "Condition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Condition resources for a patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/fhir/v0/r4/Condition",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Condition resources for a patient"
        }
      ]
    },
    {
      "info": {
        "name": "Observation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Observation resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/fhir/v0/r4/Observation",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query"
              },
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "code",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Observation resources"
        }
      ]
    },
    {
      "info": {
        "name": "MedicationRequest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search MedicationRequest resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/fhir/v0/r4/MedicationRequest",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search MedicationRequest resources"
        }
      ]
    }
  ],
  "bundled": true
}