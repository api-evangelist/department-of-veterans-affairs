{
  "opencollection": "1.0.0",
  "info": {
    "name": "VA Appeals Status AllergyIntolerance NearbyFacilities API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "NearbyFacilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Find facilities near an address or coordinates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/v1/nearby",
            "params": [
              {
                "name": "lat",
                "value": "",
                "type": "query"
              },
              {
                "name": "lng",
                "value": "",
                "type": "query"
              },
              {
                "name": "street_address",
                "value": "",
                "type": "query"
              },
              {
                "name": "city",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "zip",
                "value": "",
                "type": "query"
              },
              {
                "name": "drive_time",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Find facilities near an address or coordinates"
        }
      ]
    }
  ],
  "bundled": true
}